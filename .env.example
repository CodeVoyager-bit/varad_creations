# Copy to .env.local for development. In Vercel, set these under Project → Settings → Environment Variables.
# Never commit real values. None of these are exposed to the browser except NEXT_PUBLIC_*.

# --- Required ---------------------------------------------------------------
# MongoDB with transactions. Atlas: Connect → Drivers gives mongodb+srv://USER:PASSWORD@HOST/ —
# add the database name before the "?": .../varad_dev?... locally, .../varad?... in production.
# Local alternative: a single-node replica set (`npm run db:dev`):
MONGODB_URI=mongodb://127.0.0.1:27018/varad_dev?replicaSet=rs0&directConnection=true

# Better Auth signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public canonical URL (no trailing slash). Production: https://your-domain.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Required in production ---------------------------------------------------
# MiniMoth OTP (https://minimoth.dev). Without it, development prints codes to the server
# console; production refuses to send codes (registration and password reset are disabled).
MINIMOTH_API_KEY=

# Cloudinary for product, brand, banner and logo photos: copy the "API environment variable"
# from Cloudinary → Settings → API Keys (cloudinary://<api_key>:<api_secret>@<cloud_name>).
# Without it, development stores images in public/uploads; production rejects uploads.
CLOUDINARY_URL=

# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Optional ----------------------------------------------------------------
# Reverse geocoding for "Use my location". Default: public OpenStreetMap Nominatim
# (low volume only, attribution shown). For production volume use a Nominatim-compatible
# provider, e.g. GEOCODER_URL=https://us1.locationiq.com/v1/reverse with GEOCODER_KEY.
GEOCODER_URL=
GEOCODER_KEY=

# Require authenticator-app 2FA for admins in development too (always required in production).
ADMIN_REQUIRE_2FA=false
